# Kaffza Production Environment
# Production deploy source of truth:
# - Copy this file to production/.env
# - deploy_kaffza.sh and production/docker-compose.yml read production/.env
# - root .env/.env.production are not used by server deployment workflow

# =========================
# Core Runtime
# =========================
NODE_ENV=production
DOMAIN=kaffza.me
APP_URL=https://kaffza.me
CORS_ORIGIN=https://kaffza.me
API_PORT=4000

# =========================
# Web / Mobile Public URLs
# =========================
NEXT_PUBLIC_APP_URL="https://kaffza.me"
NEXT_PUBLIC_API_URL="https://kaffza.me/api/v1"
EXPO_PUBLIC_API_URL="https://kaffza.me/api/v1"

# =========================
# Database
# =========================
DATABASE_URL="postgresql://kaffza_user:change_me_in_production@postgres:5432/kaffza_db?schema=public"
DATABASE_NAME=kaffza_db
DATABASE_USER=kaffza_user
DATABASE_PASSWORD=change_me_in_production

# =========================
# Auth / JWT
# =========================
JWT_SECRET="min-32-char-secret-here"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="different-min-32-char-secret"
JWT_REFRESH_EXPIRATION="7d"

# =========================
# Redis / Cache
# =========================
REDIS_URL="redis://redis:6379"

# =========================
# OAuth / Social Login
# =========================
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_CLIENT_ID=""
NEXT_PUBLIC_APPLE_REDIRECT_URI="https://kaffza.me/login"

# =========================
# Bot Protection (Turnstile)
# =========================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =========================
# Payments (Thawani)
# =========================
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_REDIRECT_BASE=https://checkout.thawani.om/pay/
THAWANI_API_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_SECRET_KEY=
THAWANI_API_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
THAWANI_SUCCESS_URL=https://kaffza.me/pay/success
THAWANI_CANCEL_URL=https://kaffza.me/pay/cancel

# =========================
# SMS / Notifications
# =========================
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=Kaffza
EMAIL_PROVIDER=console

# =========================
# Storage (S3/MinIO)
# =========================
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://kaffza.me/files
S3_ACCESS_KEY=kaffza_minio
S3_SECRET_KEY=kaffza_minio_secret
S3_BUCKET=kaffza-images
S3_REGION=us-east-1
